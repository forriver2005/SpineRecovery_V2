  kind: 1
  title: "\u81C0\u6865 / \u4FA7\u6865 \xB7 \u52A8\u6001\u6A21\u5F0F\u6559\u7A0B"
  defaultGame: HipThrust_RingBridge_NewScoring
  steps:
  - id: dynamic_intro
    title: "\u52A8\u6001\u6A21\u5F0F \xB7 \u81EA\u52A8\u793A\u8303"
    narration: "\u8FD9\u5957\u6559\u7A0B\u9002\u7528\u4E8E\u52A8\u6001\u81C0\u6865\u548C\u52A8\u6001\u4FA7\u6865\u3002\u6211\u4EEC\u7528\u81C0\u6865\u7684\u5F55\u5236\u52A8\u753B\u4ECB\u7ECD\u5171\u540C\u7684\u6E38\u620F\u6D41\u7A0B\u3002\u4FA7\u6865\u7684\u59FF\u52BF\u4E0D\u540C\uFF0C\u6B63\u5F0F\u8BAD\u7EC3\u65F6\u4EE5\u5BF9\u5E94\u573A\u666F\u7684\u6559\u7EC3\u4E3A\u51C6\u3002"
    demo: 0
    minimumSeconds: 10
    voice: {fileID: 8300000, guid: bea257ad95e0ee140b81ce8784db9d90, type: 3}
  - id: dynamic_overview
    title: "\u4E09\u6BB5\u5706\u73AF \xB7 \u62AC\u8D77\u3001\u4FDD\u6301\u3001\u653E\u4E0B"
    narration: "\u5706\u73AF\u7684\u4E09\u4E2A\u533A\u57DF\u5206\u522B\u4EE3\u8868\u62AC\u8D77\u3001\u4FDD\u6301\u548C\u653E\u4E0B\u3002\u4EAE\u8D77\u7684\u533A\u57DF\u4EE5\u53CA\u524D\u8FDB\u7684\u5149\u70B9\u8868\u793A\u6559\u7EC3\u5F53\u524D\u6F14\u793A\u7684\u9636\u6BB5\uFF0C\u4E0D\u4EE3\u8868\u4F60\u5DF2\u7ECF\u5B8C\u6210\u4E86\u52A8\u4F5C\u3002"
    demo: 0
    minimumSeconds: 10
    voice: {fileID: 8300000, guid: 60b7fad9e0691c540b28f92306a4c40b, type: 3}
  - id: dynamic_lift
    title: "\u7B2C\u4E00\u6BB5 \xB7 \u62AC\u8D77"
    narration: "\u62AC\u8D77\u9636\u6BB5\u5F00\u59CB\u65F6\uFF0C\u5BF9\u5E94\u7684\u5706\u73AF\u9010\u6E10\u4EAE\u8D77\uFF0C\u6559\u7EC3\u6A21\u578B\u4ECE\u8D77\u59CB\u4F4D\u7F6E\u62AC\u8D77\u3002\u6B63\u5F0F\u6E38\u620F\u4F1A\u68C0\u67E5\u5B9E\u9645\u52A8\u4F5C\uFF0C\u4E0D\u80FD\u53EA\u7B49\u5F85\u52A8\u753B\u64AD\u653E\u7ED3\u675F\u3002"
    demo: 9
    minimumSeconds: 8
    voice: {fileID: 8300000, guid: 4d31c154f23675b4f980c9d7f41ae645, type: 3}
  - id: dynamic_hold
    title: "\u7B2C\u4E8C\u6BB5 \xB7 \u4FDD\u6301\u4E0E\u8BC4\u5206"
    narration: "\u8FDB\u5165\u4FDD\u6301\u9636\u6BB5\u540E\uFF0C\u5173\u6CE8\u52A8\u4F5C\u8D28\u91CF\u548C\u4FDD\u6301\u5206\u3002\u8FBE\u5230\u8981\u6C42\u5E76\u6709\u6548\u4FDD\u6301\uFF0C\u624D\u4F1A\u4EA7\u751F\u6709\u6548\u7684\u8BC4\u5206\u3002\u6559\u7EC3\u7684\u793A\u8303\u8FDB\u5EA6\u4E0E\u7528\u6237\u7684\u5B9E\u9645\u5F97\u5206\uFF0C\u662F\u4E24\u4E2A\u4E0D\u540C\u7684\u4FE1\u606F\u3002"
    demo: 10
    minimumSeconds: 10
    voice: {fileID: 8300000, guid: ddf16fde874d0c74d90a1266fe532c25, type: 3}
  - id: dynamic_lower
    title: "\u7B2C\u4E09\u6BB5 \xB7 \u653E\u4E0B"
    narration: "\u653E\u4E0B\u9636\u6BB5\u8DDF\u968F\u6559\u7EC3\u56DE\u5230\u8D77\u59CB\u4F4D\u7F6E\u3002\u5B8C\u6574\u7684\u4E00\u8F6E\u5305\u62EC\u62AC\u8D77\u3001\u4FDD\u6301\u548C\u653E\u4E0B\u3002\u4FA7\u6865\u8FD8\u4F1A\u663E\u793A\u5B9E\u9645\u5408\u683C\u6B21\u6570\uFF0C\u793A\u8303\u7ED3\u675F\u6B21\u6570\u4E0D\u7B49\u4E8E\u5B9E\u9645\u5B8C\u6210\u6B21\u6570\u3002"
    demo: 11
    minimumSeconds: 9
    voice: {fileID: 8300000, guid: 173d640f3bddcc34194faefb2bff280c, type: 3}
  - id: dynamic_hit
    title: "\u8FBE\u6807\u793A\u4F8B \xB7 HIT"
    narration: "\u8FD9\u662F\u52A8\u4F5C\u8FBE\u6807\u7684\u793A\u4F8B\uFF0C\u6559\u7A0B\u7528\u547D\u4E2D\u6807\u8BB0\u5E2E\u52A9\u7406\u89E3\u3002\u6A21\u578B\u5B8C\u6210\u62AC\u8D77\u3001\u6709\u6548\u4FDD\u6301\u548C\u653E\u4E0B\uFF0C\u793A\u4F8B\u4FDD\u6301\u5206\u589E\u52A0\u3002\u6B63\u5F0F\u6E38\u620F\u8BF7\u4EE5\u5BF9\u5E94\u573A\u666F\u7684\u8BC4\u5206\u548C\u6B21\u6570\u53CD\u9988\u4E3A\u51C6\u3002"
    demo: 7
    minimumSeconds: 10
    voice: {fileID: 8300000, guid: 6e3c960e435503b4d84d8d672780d24e, type: 3}
  - id: dynamic_miss
    title: "\u672A\u8FBE\u6807\u793A\u4F8B \xB7 MISS"
    narration: "\u8FD9\u662F\u672A\u8FBE\u6807\u7684\u793A\u4F8B\uFF0C\u6559\u7A0B\u7528\u6F0F\u51FB\u6807\u8BB0\u63D0\u793A\u3002\u6A21\u578B\u6CA1\u6709\u62AC\u5230\u8981\u6C42\u7684\u4F4D\u7F6E\uFF0C\u867D\u7136\u6559\u7EC3\u5706\u73AF\u4ECD\u5728\u63A8\u8FDB\uFF0C\u5B9E\u9645\u52A8\u4F5C\u6CA1\u6709\u8FBE\u6807\uFF0C\u5C31\u4E0D\u80FD\u628A\u793A\u8303\u8FDB\u5EA6\u5F53\u4F5C\u6709\u6548\u5F97\u5206\u3002"
    demo: 8
    minimumSeconds: 10
    voice: {fileID: 8300000, guid: a810b855cd4534e4c823e4a81f8014b5, type: 3}
  - id: dynamic_summary
    title: "\u8DDF\u968F\u4E09\u9636\u6BB5 \xB7 \u5173\u6CE8\u5B9E\u9645\u53CD\u9988"
    narration: "\u8BB0\u4F4F\u62AC\u8D77\u3001\u4FDD\u6301\u3001\u653E\u4E0B\u7684\u987A\u5E8F\u3002\u5706\u73AF\u770B\u9636\u6BB5\uFF0C\u6559\u7EC3\u770B\u59FF\u52BF\uFF0C\u8BC4\u5206\u548C\u6B21\u6570\u770B\u5B9E\u9645\u5B8C\u6210\u60C5\u51B5\u3002\u672C\u6559\u7A0B\u7684\u6570\u636E\u53EA\u662F\u6F14\u793A\uFF0C\u4E0D\u4F1A\u8BA1\u5165\u4F60\u7684\u8BAD\u7EC3\u8BB0\u5F55\u3002"
    demo: 14
    minimumSeconds: 9
    voice: {fileID: 8300000, guid: 6d784e56e91949e4cb21a564c3724d9d, type: 3}
