  m_Script: {fileID: 11500000, guid: 33bd1e3a07af39246bcd60dac58d5b98, type: 3}
  m_Name: Tutorial_BridgeHold
  m_EditorClassIdentifier: 
  kind: 2
  title: "\u81C0\u6865\u4FDD\u6301 / \u4FA7\u6865\u4FDD\u6301 \xB7 \u6559\u7A0B"
  defaultGame: HipThrust_RingBridge_Hold30
  steps:
  - id: hold_intro
    title: "\u4FDD\u6301\u6A21\u5F0F \xB7 \u81EA\u52A8\u793A\u8303"
    narration: "\u8FD9\u5957\u6559\u7A0B\u9002\u7528\u4E8E\u81C0\u6865\u4FDD\u6301\u548C\u4FA7\u6865\u4FDD\u6301\u3002\u6211\u4EEC\u7528\u81C0\u6865\u52A8\u753B\u8BF4\u660E\u5171\u540C\u7684\u4E09\u9636\u6BB5\u6D41\u7A0B\uFF0C\u4EE5\u53CA\u4E09\u5341\u79D2\u4FDD\u6301\u7684\u73A9\u6CD5\u3002\u73B0\u5728\u4E0D\u9700\u8981\u7528\u6237\u52A8\u4F5C\u8F93\u5165\u3002"
    demo: 0
    minimumSeconds: 9
    voice: {fileID: 8300000, guid: bf5b88cbaefb5f74c827db1ade179381, type: 3}
  - id: hold_overview
    title: "\u793A\u8303\u5012\u8BA1\u65F6 \u2260 \u6709\u6548\u4FDD\u6301"
    narration: "\u5706\u73AF\u4ECD\u7136\u5206\u4E3A\u62AC\u8D77\u3001\u4FDD\u6301\u548C\u653E\u4E0B\u3002\u6559\u7EC3\u5012\u8BA1\u65F6\u8868\u793A\u793A\u8303\u5269\u4F59\u65F6\u95F4\uFF1B\u6709\u6548\u4FDD\u6301\u65F6\u95F4\u8868\u793A\u5B9E\u9645\u8FBE\u6807\u7684\u65F6\u95F4\u3002\u4E24\u8005\u4E0D\u80FD\u6DF7\u4E3A\u4E00\u8C08\u3002"
    demo: 0
    minimumSeconds: 9
    voice: {fileID: 8300000, guid: 9e3bef8be65842f48987daa5706f8237, type: 3}
  - id: hold_lift
    title: "\u5148\u62AC\u8D77 \xB7 \u518D\u8FDB\u5165\u4FDD\u6301"
    narration: "\u5148\u4ECE\u8D77\u59CB\u4F4D\u7F6E\u62AC\u8D77\uFF0C\u8FBE\u5230\u4FDD\u6301\u9636\u6BB5\u8981\u6C42\u7684\u59FF\u6001\u3002\u6A21\u578B\u5230\u8FBE\u9AD8\u4F4D\u4E4B\u540E\uFF0C\u4FDD\u6301\u9636\u6BB5\u624D\u5F00\u59CB\u3002"
    demo: 9
    minimumSeconds: 7
    voice: {fileID: 8300000, guid: ccb5a076c4cbc2141a83cdae4c44bbf0, type: 3}
  - id: hold_thirty
    title: "\u5B8C\u6574\u6F14\u793A \xB7 30 \u79D2\u4FDD\u6301"
    narration: "\u73B0\u5728\u6F14\u793A\u5B8C\u6574\u7684\u4E09\u5341\u79D2\u4FDD\u6301\uFF0C\u8FD9\u4E00\u8282\u6CA1\u6709\u52A0\u901F\u3002\u6A21\u578B\u81EA\u52A8\u4FDD\u6301\uFF0C\u793A\u4F8B\u6709\u6548\u65F6\u95F4\u9010\u79D2\u589E\u52A0\u3002\u6B63\u5F0F\u6E38\u620F\u4E2D\uFF0C\u53EA\u6709\u52A8\u4F5C\u6301\u7EED\u8FBE\u6807\u7684\u65F6\u95F4\u624D\u6709\u6548\u3002\u4F60\u53EF\u4EE5\u6682\u505C\u89C2\u770B\uFF0C\u6216\u70B9\u51FB\u4E0B\u4E00\u8282\u8DF3\u8FC7\u6F14\u793A\u3002"
    demo: 12
    minimumSeconds: 36
    voice: {fileID: 8300000, guid: 6698c5cee1d16754eb88c973d087f095, type: 3}
  - id: hold_interrupted
    title: "\u4E2D\u65AD\u793A\u4F8B \xB7 \u8FDE\u7EED\u4FDD\u6301\u91CD\u65B0\u7D2F\u8BA1"
    narration: "\u770B\u8FD9\u6B21\u4E2D\u65AD\u793A\u4F8B\uFF1A\u59FF\u52BF\u6301\u7EED\u504F\u79BB\u8981\u6C42\uFF0C\u793A\u4F8B\u6709\u6548\u65F6\u95F4\u505C\u6B62\uFF0C\u5E76\u91CD\u65B0\u4ECE\u96F6\u7D2F\u8BA1\u3002\u6B63\u5F0F\u6E38\u620F\u4F1A\u5BB9\u5FCD\u77ED\u6682\u6CE2\u52A8\uFF0C\u4F46\u660E\u663E\u4E2D\u65AD\u540E\uFF0C\u4E0D\u80FD\u628A\u524D\u540E\u4E24\u6BB5\u65F6\u95F4\u62FC\u6210\u4E00\u6B21\u8FDE\u7EED\u4FDD\u6301\u3002"
    demo: 13
    minimumSeconds: 12
    voice: {fileID: 8300000, guid: 2d82214edbddd834898c248891a6b276, type: 3}
  - id: hold_hit
    title: "\u8FBE\u6807\u793A\u4F8B \xB7 \u5B8C\u6210\u540E\u653E\u4E0B"
    narration: "\u5B8C\u6210\u8981\u6C42\u7684\u6709\u6548\u4FDD\u6301\u540E\uFF0C\u8FD8\u8981\u8DDF\u968F\u653E\u4E0B\u63D0\u793A\u56DE\u5230\u8D77\u59CB\u4F4D\u7F6E\u3002\u6559\u7A0B\u4E2D\u7684\u547D\u4E2D\u6807\u8BB0\u53EA\u662F\u8FBE\u6807\u793A\u610F\uFF1B\u6B63\u5F0F\u6E38\u620F\u4EE5\u5B9E\u9645\u8BC4\u5206\u3001\u4FDD\u6301\u65F6\u95F4\u548C\u5408\u683C\u6B21\u6570\u4E3A\u51C6\u3002"
    demo: 7
    minimumSeconds: 10
    voice: {fileID: 8300000, guid: c2e88e7980a65134a92cd31e54b9d24f, type: 3}
  - id: hold_miss
    title: "\u672A\u8FBE\u6807\u793A\u4F8B \xB7 \u7B49\u5F85\u4E0D\u7B49\u4E8E\u5B8C\u6210"
    narration: "\u8FD9\u6B21\u6A21\u578B\u6CA1\u6709\u8FBE\u5230\u8981\u6C42\u7684\u4FDD\u6301\u59FF\u6001\u3002\u5373\u4F7F\u6559\u7EC3\u7684\u4E09\u5341\u79D2\u5012\u8BA1\u65F6\u7ED3\u675F\uFF0C\u4E5F\u4E0D\u4EE3\u8868\u7528\u6237\u5B8C\u6210\u4E86\u4E09\u5341\u79D2\u6709\u6548\u4FDD\u6301\u3002\u6CA1\u6709\u6709\u6548\u52A8\u4F5C\u6570\u636E\uFF0C\u540C\u6837\u4E0D\u80FD\u7B97\u4F5C\u5B8C\u6210\u3002"
    demo: 8
    minimumSeconds: 10
    voice: {fileID: 8300000, guid: 6004e3076025ad846931f0c13eec004c, type: 3}
  - id: hold_summary
    title: "\u770B\u59FF\u6001\u3001\u770B\u6709\u6548\u65F6\u95F4\u3001\u5B8C\u6210\u653E\u4E0B"
    narration: "\u8BB0\u4F4F\uFF1A\u8FBE\u5230\u59FF\u6001\uFF0C\u6301\u7EED\u6709\u6548\u4FDD\u6301\uFF0C\u6700\u540E\u5B8C\u6210\u653E\u4E0B\u3002\u4FA7\u6865\u8FD8\u8981\u5173\u6CE8\u5408\u683C\u6B21\u6570\u3002\u6559\u7A0B\u652F\u6301\u6682\u505C\u548C\u91CD\u64AD\uFF0C\u6F14\u793A\u4E0D\u4F1A\u6539\u53D8\u4F60\u7684\u8BAD\u7EC3\u6210\u7EE9\uFF1B\u8FD4\u56DE\u6E38\u620F\u540E\u4ECD\u4FDD\u6301\u6682\u505C\u3002"
    demo: 14
    minimumSeconds: 10
    voice: {fileID: 8300000, guid: 9747f0ad87503e049b5ea8d45fc93371, type: 3}
