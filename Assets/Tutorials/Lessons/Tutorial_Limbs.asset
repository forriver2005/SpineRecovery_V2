  m_Name: Tutorial_Limbs
  m_EditorClassIdentifier: 
  kind: 0
  title: "\u9E1F\u72D7 / \u6B7B\u866B \xB7 \u56DB\u80A2\u8282\u594F\u6559\u7A0B"
  defaultGame: BirdDog_RingSkinC_Recorded
  steps:
  - id: limbs_intro
    title: "\u5148\u770B\u6F14\u793A\uFF0C\u518D\u5F00\u59CB\u6E38\u620F"
    narration: "\u8FD9\u5957\u6559\u7A0B\u9002\u7528\u4E8E\u9E1F\u72D7\u5F0F\u548C\u6B7B\u866B\u5F0F\u3002\u73B0\u5728\u53EA\u9700\u89C2\u770B\uFF1A\u6A21\u578B\u3001\u97F3\u7B26\u548C\u5224\u5B9A\u90FD\u4F1A\u81EA\u52A8\u6F14\u793A\uFF0C\u4E0D\u9700\u8981\u4F69\u6234\u8FFD\u8E2A\u5668\uFF0C\u4E5F\u4E0D\u9700\u8981\u8DDF\u7740\u505A\u52A8\u4F5C\u3002"
    demo: 0
    minimumSeconds: 9
    voice: {fileID: 8300000, guid: e0f98cc23e431a044947a001104bfdc3, type: 3}
  - id: limbs_left_arm
    title: "\u5DE6\u4E0A\u89D2 \xB7 \u5DE6\u81C2"
    narration: "\u5706\u73AF\u5206\u4E3A\u56DB\u4E2A\u80A2\u4F53\u533A\u57DF\u3002\u5DE6\u4E0A\u89D2\u7684\u7C89\u8272\u533A\u57DF\u4EE3\u8868\u5DE6\u81C2\u3002\u8FD9\u91CC\u7684\u5DE6\u53F3\uFF0C\u6307\u7684\u662F\u4F60\u81EA\u5DF1\u7684\u5DE6\u53F3\u4FA7\u3002"
    demo: 1
    minimumSeconds: 7
    voice: {fileID: 8300000, guid: 7ffab6b1ca63d17438481bf7c67f6426, type: 3}
  - id: limbs_right_arm
    title: "\u53F3\u4E0A\u89D2 \xB7 \u53F3\u81C2"
    narration: "\u53F3\u4E0A\u89D2\u7684\u9EC4\u8272\u533A\u57DF\u4EE3\u8868\u53F3\u81C2\u3002\u770B\u5230\u8FD9\u4E2A\u533A\u57DF\u7684\u97F3\u7B26\u65F6\uFF0C\u8981\u5173\u6CE8\u53F3\u81C2\u662F\u5426\u5B8C\u6210\u5F53\u524D\u8981\u6C42\u7684\u52A8\u4F5C\u3002"
    demo: 2
    minimumSeconds: 7
    voice: {fileID: 8300000, guid: bda75ff02c639f2458b5465771144daa, type: 3}
  - id: limbs_left_leg
    title: "\u5DE6\u4E0B\u89D2 \xB7 \u5DE6\u817F"
    narration: "\u5DE6\u4E0B\u89D2\u7684\u9752\u7EFF\u8272\u533A\u57DF\u4EE3\u8868\u5DE6\u817F\u3002\u6BCF\u4E2A\u533A\u57DF\u90FD\u6709\u6587\u5B57\u6807\u8BB0\uFF0C\u53EF\u4EE5\u7ED3\u5408\u6587\u5B57\u548C\u989C\u8272\u8BC6\u522B\u3002"
    demo: 3
    minimumSeconds: 7
    voice: {fileID: 8300000, guid: a0a2e05656f20f74e8a4470c4a68e8fb, type: 3}
  - id: limbs_right_leg
    title: "\u53F3\u4E0B\u89D2 \xB7 \u53F3\u817F"
    narration: "\u53F3\u4E0B\u89D2\u7684\u6D45\u7D2B\u8272\u533A\u57DF\u4EE3\u8868\u53F3\u817F\u3002\u56DB\u4E2A\u533A\u57DF\u5206\u522B\u68C0\u67E5\u5BF9\u5E94\u80A2\u4F53\uFF0C\u4E0D\u8981\u53EA\u770B\u6A21\u578B\u7684\u6574\u4F53\u52A8\u4F5C\u3002"
    demo: 4
    minimumSeconds: 7
    voice: {fileID: 8300000, guid: ab57ed6227b6f724fa5fb11aa2968b32, type: 3}
  - id: limbs_coach
    title: "\u53F3\u4FA7\u6559\u7EC3 \xB7 \u5F53\u524D\u52A8\u4F5C"
    narration: "\u53F3\u4FA7\u6A21\u578B\u662F\u6559\u7EC3\u793A\u8303\u3002\u4F38\u5C55\u3001\u6536\u56DE\u548C\u8FDB\u5EA6\u63D0\u793A\u5E2E\u52A9\u4F60\u7406\u89E3\u5F53\u524D\u9636\u6BB5\u3002\u6B63\u5F0F\u6E38\u620F\u65F6\uFF0C\u8DDF\u968F\u6559\u7EC3\u5B8C\u6210\u52A8\u4F5C\uFF1B\u6559\u7A0B\u91CC\u7684\u6A21\u578B\u7531\u5F55\u5236\u52A8\u753B\u81EA\u52A8\u64AD\u653E\u3002"
    demo: 5
    minimumSeconds: 10
    voice: {fileID: 8300000, guid: 689d96b402bae714aa1f48055085b4da, type: 3}
  - id: limbs_approach
    title: "\u97F3\u7B26\u9760\u8FD1 \xB7 \u63D0\u524D\u51C6\u5907"
    narration: "\u97F3\u7B26\u4ECE\u5916\u4FA7\u671D\u5BF9\u5E94\u7684\u5706\u73AF\u533A\u57DF\u79FB\u52A8\u3002\u9760\u8FD1\u5224\u5B9A\u4F4D\u7F6E\u65F6\uFF0C\u5B8C\u6210\u5BF9\u5E94\u80A2\u4F53\u7684\u76EE\u6807\u52A8\u4F5C\u3002\u4E2D\u95F4\u7684\u661F\u5F62\u662F\u5706\u73AF\u4E2D\u5FC3\uFF0C\u4E0D\u662F\u9700\u8981\u70B9\u51FB\u7684\u6309\u94AE\u3002"
    demo: 6
    minimumSeconds: 9
    voice: {fileID: 8300000, guid: 3a63391aa7685e44db0e9caf99050f01, type: 3}
  - id: limbs_hit
    title: "HIT \xB7 \u547D\u4E2D\u793A\u8303"
    narration: "\u770B\u8FD9\u6B21\u793A\u8303\uFF1A\u5DE6\u81C2\u548C\u53F3\u817F\u4F38\u5C55\u5230\u4F4D\uFF0C\u97F3\u7B26\u5230\u8FBE\u5224\u5B9A\u4F4D\u7F6E\u540E\u51FA\u73B0\u547D\u4E2D\u53CD\u9988\u3002\u547D\u4E2D\u9700\u8981\u5BF9\u5E94\u80A2\u4F53\u8FBE\u5230\u52A8\u4F5C\u8981\u6C42\uFF0C\u4E0D\u80FD\u7528\u70B9\u51FB\u5C4F\u5E55\u4EE3\u66FF\u3002"
    demo: 7
    minimumSeconds: 9
    voice: {fileID: 8300000, guid: c3068e8c691aa6a4690b9befe9b8ff68, type: 3}
  - id: limbs_miss
    title: "MISS \xB7 \u6F0F\u51FB\u793A\u8303"
    narration: "\u8FD9\u6B21\u6A21\u578B\u6CA1\u6709\u5B8C\u6210\u8981\u6C42\u7684\u4F38\u5C55\u3002\u97F3\u7B26\u5230\u8FBE\u540E\u4ECD\u672A\u8FBE\u6807\uFF0C\u5C31\u51FA\u73B0\u6F0F\u51FB\u3002\u52A8\u4F5C\u4E0D\u5230\u4F4D\u3001\u9519\u8FC7\u5224\u5B9A\u65F6\u673A\uFF0C\u6216\u8005\u6CA1\u6709\u6709\u6548\u7684\u52A8\u4F5C\u6570\u636E\uFF0C\u90FD\u53EF\u80FD\u65E0\u6CD5\u547D\u4E2D\u3002"
    demo: 8
    minimumSeconds: 10
    voice: {fileID: 8300000, guid: 60810d82abcd5804b8a4462180624fd2, type: 3}
  - id: limbs_summary
    title: "\u8BB0\u4F4F\uFF1A\u770B\u533A\u57DF\u3001\u8DDF\u6559\u7EC3\u3001\u7B49\u5224\u5B9A"
    narration: "\u9E1F\u72D7\u5F0F\u548C\u6B7B\u866B\u5F0F\u5171\u7528\u8FD9\u5957\u56DB\u80A2\u5224\u5B9A\u65B9\u5F0F\uFF0C\u5177\u4F53\u52A8\u4F5C\u4EE5\u6559\u7EC3\u793A\u8303\u4E3A\u51C6\u3002\u4F60\u53EF\u4EE5\u91CD\u64AD\u4EFB\u610F\u4E00\u8282\uFF0C\u4E5F\u53EF\u4EE5\u8FD4\u56DE\u6E38\u620F\u3002\u8FD4\u56DE\u540E\u4ECD\u4FDD\u6301\u6682\u505C\uFF0C\u51C6\u5907\u597D\u518D\u7EE7\u7EED\u8BAD\u7EC3\u3002"
    demo: 14
    minimumSeconds: 10
    voice: {fileID: 8300000, guid: 04fa4e16d282eeb4c842ac94e8512586, type: 3}
